---
import { getBooks } from '../lib/library'

const books = await getBooks()
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="续章：一起写故事，一起读故事。" />
    <title>续章 · 一起写下去</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">续章 <span>CHAPTER GARDEN</span></a>
      <a class="header-link" href="https://github.com/steven-zhc/chapter-garden">参与创作 ↗</a>
    </header>
    <main class="home-main">
      <div class="hero">
        <p class="eyebrow">A STORY IS NEVER FINISHED ALONE</p>
        <h1>故事，还可以<br /><em>这样写下去。</em></h1>
        <p>一个人写下开头，另一个人推开下一扇门。这里的每本书，都欢迎新的作者。</p>
      </div>
      <section class="library" aria-labelledby="library-title">
        <div class="section-heading"><h2 id="library-title">书架</h2><span>{books.length} 本共创故事</span></div>
        <div class="book-grid">
          {books.map((book, index) => (
            <a class="book-card" href={`/books/${book.slug}/`}>
              <div class="book-cover"><span class="book-cover-number">{String(index + 1).padStart(2, '0')}</span><strong>{book.title}</strong><span>续章 · 共创小说</span></div>
              <div class="book-card-text"><h3>{book.title}</h3><p>{book.description}</p><span>{book.chapters.length} 章 · {book.author} <b>开始阅读 →</b></span></div>
            </a>
          ))}
        </div>
      </section>
    </main>
    <footer class="home-footer">续章 · 故事由每一位作者继续。</footer>
  </body>
</html>
