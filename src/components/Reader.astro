---
import type { Book, Chapter } from '../lib/library'
import { bookUrl, chapterSlug, chapterUrl, getBooks, homeUrl } from '../lib/library'
import { copy } from '../lib/i18n'

type Props = { book: Book; chapter: Chapter }
const { book, chapter } = Astro.props
const current = book.chapters.findIndex((item) => item.id === chapter.id)
const previous = book.chapters[current - 1]
const next = book.chapters[current + 1]
const t = copy[book.locale]
const otherLocale = book.locale === 'zh' ? 'en' : 'zh'
const otherBook = (await getBooks(otherLocale)).find((item) => item.slug === book.slug)
const otherChapter = otherBook?.chapters.find((item) => chapterSlug(item) === chapterSlug(chapter))
const alternateUrl = otherBook && otherChapter ? chapterUrl(otherBook, otherChapter) : undefined
---

<!doctype html>
<html lang={book.locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={book.description} />
    <title>{chapter.data.title} · {book.title} · {t.site}</title>
    {alternateUrl && <link rel="alternate" hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'} href={new URL(alternateUrl, Astro.site)} />}
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homeUrl(book.locale)}>{t.site} <span>{book.locale === 'zh' ? 'CHAPTER GARDEN' : '章节花园'}</span></a>
      <nav class="header-actions" aria-label={book.locale === 'zh' ? '网站导航' : 'Site navigation'}>
        <a class="language-link" href={alternateUrl ?? homeUrl(otherLocale)} lang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{alternateUrl ? t.inOtherLanguage : t.otherHome}</a>
        <a class="header-link" href={homeUrl(book.locale)}>{t.allStories}</a>
      </nav>
    </header>
    <div class="reader-shell">
      <aside class="sidebar" aria-label={t.chapterList}>
        <div class="sidebar-inner">
          <p class="eyebrow">{book.genre} · {book.author}</p>
          <h1><a href={bookUrl(book)}>{book.title}</a></h1>
          <p class="book-description">{book.description}</p>
          <div class="sidebar-rule"></div>
          <p class="sidebar-label">{t.contents} <span>{t.chapterCount(book.chapters.length)}</span></p>
          <nav aria-label={t.chapter}>
            <ol class="chapter-list">
              {book.chapters.map((item) => (
                <li>
                  <a href={chapterUrl(book, item)} aria-current={item.id === chapter.id ? 'page' : undefined}>
                    <span class="chapter-number">{String(item.data.order).padStart(2, '0')}</span>
                    <span>{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>
      <main class="reading-area">
        <article>
          <p class="eyebrow">{book.title} / {t.chapterHeading(chapter.data.order)}{chapter.data.author ? ` / ${chapter.data.author}` : ''}{chapter.data.translator ? ` / ${chapter.data.translator}` : ''}</p>
          <h2>{chapter.data.title}</h2>
          <div class="chapter-content"><slot /></div>
        </article>
        <nav class="chapter-navigation" aria-label={book.locale === 'zh' ? '前后章节' : 'Previous and next chapters'}>
          {previous ? <a href={chapterUrl(book, previous)}>← {previous.data.title}</a> : <span />}
          {next ? <a href={chapterUrl(book, next)}>{next.data.title} →</a> : <span class="chapter-end">{t.toBeContinued}</span>}
        </nav>
        <footer>{t.readerFooter}</footer>
      </main>
    </div>
  </body>
</html>
